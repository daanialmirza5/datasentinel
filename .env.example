# DataSentinel configuration — copy to backend/.env (or set real environment variables).
# Nothing here is required for local development; the defaults are shown.
# Never commit a real .env file.

# development | test | production
DATASENTINEL_ENVIRONMENT=development

# Where uploaded datasets, generated lab data and the SQLite database live.
# DATASENTINEL_DATA_DIR=./var

# Optional PostgreSQL instead of SQLite (requires: pip install "psycopg[binary]")
# DATASENTINEL_DATABASE_URL=postgresql+psycopg://datasentinel:change-me@localhost:5432/datasentinel

# Comma-separated list of browser origins allowed to call the API.
DATASENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Resource limits
DATASENTINEL_MAX_UPLOAD_MB=25
DATASENTINEL_MAX_ROWS=200000
DATASENTINEL_MAX_COLUMNS=200
DATASENTINEL_MAX_CELL_CHARS=10000
DATASENTINEL_MAX_VERSIONS_PER_DATASET=50
DATASENTINEL_REGEX_TIMEOUT_SECONDS=2

# Fault-injection lab data is generated, never user data; it expires after this many hours (0 = keep).
DATASENTINEL_EXPERIMENT_RETENTION_HOURS=24

# Apply database migrations on startup / import the bundled sample workspace on first start.
DATASENTINEL_AUTO_MIGRATE=true
DATASENTINEL_LOAD_SAMPLES_ON_STARTUP=false

DATASENTINEL_LOG_LEVEL=INFO

# Frontend (build time). Leave empty to call the API on the same origin (/api via proxy).
# VITE_API_BASE_URL=https://your-backend.example.com
